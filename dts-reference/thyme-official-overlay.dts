/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. xiaomi thyme";
	compatible = "qcom,kona-mtp", "qcom,kona", "qcom,mtp";
	qcom,board-id = <0x2d 0x00>;

	fragment@0 {
		target = <&sde_dsi_active>;

		__overlay__ {

			mux {
				pins = "gpio12", "gpio50";
				function = "gpio";
			};

			config {
				pins = "gpio12", "gpio50";
				drive-strength = <0x08>;
				bias-disable = <0x00>;
			};
		};
	};

	fragment@1 {
		target = <&sde_dsi_suspend>;

		__overlay__ {

			mux {
				pins = "gpio12", "gpio50";
				function = "gpio";
			};

			config {
				pins = "gpio12", "gpio50";
				drive-strength = <0x02>;
				bias-pull-down;
			};
		};
	};

	fragment@2 {
		target = <&nfc_enable_active>;

		__overlay__ {

			mux {
				pins = "gpio83", "gpio110";
				function = "gpio";
			};

			config {
				pins = "gpio83", "gpio110";
				drive-strength = <0x02>;
				bias-pull-up;
			};
		};
	};

	fragment@3 {
		target = <&nfc_enable_suspend>;

		__overlay__ {

			mux {
				pins = "gpio83", "gpio110";
				function = "gpio";
			};

			config {
				pins = "gpio83", "gpio110";
				drive-strength = <0x02>;
				bias-disable;
			};
		};
	};

	fragment@4 {
		target = <&tlmm>;

		__overlay__ {

			onewire_gpio_active: onewire_gpio_active {
				phandle = <0xb0>;

				mux {
					pins = "gpio9";
					function = "gpio";
				};

				config {
					pins = "gpio9";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			onewire_gpio_sleep: onewire_gpio_sleep {
				phandle = <0xb1>;

				mux {
					pins = "gpio9";
					function = "gpio";
				};

				config {
					pins = "gpio9";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			ncp3902 {

				ncp3902_en_active: ncp3902_en_active {
					phandle = <0x0c>;

					mux {
						pins = "gpio152";
						function = "gpio";
					};

					config {
						pins = "gpio152";
						bias-disable;
						drive-strength = <0x10>;
						output-low;
					};
				};

				ncp3902_en_suspend: ncp3902_en_suspend {
					phandle = <0x10>;

					mux {
						pins = "gpio152";
						function = "gpio";
					};

					config {
						pins = "gpio152";
						drive-strength = <0x10>;
						bias-disable;
						output-low;
					};
				};
			};

			ncp3902_pass_en {

				ncp3902_pass_en_active: ncp3902_pass_en_active {
					phandle = <0x0f>;

					mux {
						pins = "gpio153";
						function = "gpio";
					};

					config {
						pins = "gpio153";
						bias-disable;
						drive-strength = <0x10>;
						output-low;
					};
				};

				ncp3902_pass_en_suspend: ncp3902_pass_en_suspend {
					phandle = <0x13>;

					mux {
						pins = "gpio153";
						function = "gpio";
					};

					config {
						pins = "gpio153";
						drive-strength = <0x10>;
						bias-disable;
						output-low;
					};
				};
			};

			dc_chg_enable {

				dc_en_active: dc_en_active {
					phandle = <0x0d>;

					mux {
						pins = "gpio82";
						function = "gpio";
					};

					config {
						pins = "gpio82";
						bias-disable;
						drive-strength = <0x08>;
						output-low;
					};
				};

				dc_en_suspend: dc_en_suspend {
					phandle = <0x11>;

					mux {
						pins = "gpio82";
						function = "gpio";
					};

					config {
						pins = "gpio82";
						drive-strength = <0x08>;
						bias-disable;
						output-low;
					};
				};
			};

			rx_hw_sleep_enable {

				rx_hw_en_active: rx_hw_en_active {
					phandle = <0x0e>;

					mux {
						pins = "gpio78";
						function = "gpio";
					};

					config {
						pins = "gpio78";
						bias-disable;
						drive-strength = <0x08>;
						output-high;
					};
				};

				rx_hw_en_suspend: rx_hw_en_suspend {
					phandle = <0x12>;

					mux {
						pins = "gpio78";
						function = "gpio";
					};

					config {
						pins = "gpio78";
						drive-strength = <0x08>;
						bias-disable;
						output-low;
					};
				};
			};

			bq2597x {

				bq2597x_master_int_default: bq2597x_master_int_default {
					phandle = <0xa1>;

					mux {
						pins = "gpio68";
						function = "gpio";
					};

					config {
						pins = "gpio68";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				bq2597x_master_int_suspend: bq2597x_master_int_suspend {
					phandle = <0xd1>;

					mux {
						pins = "gpio68";
						function = "gpio";
					};

					config {
						pins = "gpio68";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				bq2597x_slave_int_default: bq2597x_slave_int_default {
					phandle = <0x0b>;

					mux {
						pins = "gpio84";
						function = "gpio";
					};

					config {
						pins = "gpio84";
						drive-strength = <0x02>;
						bias-pull-down;
						output-low;
					};
				};
			};

			ln8282_enable_active: ln8282_enable_active {
				phandle = <0xa2>;

				mux {
					pins = "gpio156";
					function = "gpio";
				};

				config {
					pins = "gpio156";
					drive-strength = <0x02>;
					bias-pull-down;
					output-low;
				};
			};

			ln8282_enable_suspend: ln8282_enable_suspend {
				phandle = <0xa3>;

				mux {
					pins = "gpio156";
					function = "gpio";
				};

				config {
					pins = "gpio156";
					drive-strength = <0x02>;
					bias-pull-up;
					output-high;
				};
			};

			txon_enable_active: txon_enable_active {
				phandle = <0xa7>;

				mux {
					pins = "gpio154";
					function = "gpio";
				};

				config {
					pins = "gpio154";
					drive-strength = <0x10>;
					bias-disable;
					bias-pull-down;
					output-low;
				};
			};

			txon_enable_suspend: txon_enable_suspend {
				phandle = <0xaa>;

				mux {
					pins = "gpio154";
					function = "gpio";
				};

				config {
					pins = "gpio154";
					drive-strength = <0x10>;
					bias-disable;
					bias-pull-down;
					output-low;
				};
			};

			rx1619 {

				nu_int_active: nu_int_active {
					phandle = <0xab>;

					mux {
						pins = "gpio157";
						function = "gpio";
					};

					config {
						pins = "gpio157";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				nu_int_suspend: nu_int_suspend {
					phandle = <0xad>;

					mux {
						pins = "gpio157";
						function = "gpio";
					};

					config {
						pins = "gpio157";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				nu_sleep_active: nu_sleep_active {
					phandle = <0xac>;

					mux {
						pins = "gpio155";
						function = "gpio";
					};

					config {
						pins = "gpio155";
						drive-strength = <0x08>;
						bias-disable;
						bias-pull-down;
						output-low;
					};
				};

				nu_sleep_suspend: nu_sleep_suspend {
					phandle = <0xae>;

					mux {
						pins = "gpio155";
						function = "gpio";
					};

					config {
						pins = "gpio155";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};
			};

			idt {

				idt_int_active: idt_int_active {
					phandle = <0xa5>;

					mux {
						pins = "gpio157";
						function = "gpio";
					};

					config {
						pins = "gpio157";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				idt_int_suspend: idt_int_suspend {
					phandle = <0xa8>;

					mux {
						pins = "gpio157";
						function = "gpio";
					};

					config {
						pins = "gpio157";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				idt_enable_active: idt_enable_active {
					phandle = <0xa6>;

					mux {
						pins = "gpio155";
						function = "gpio";
					};

					config {
						pins = "gpio155";
						drive-strength = <0x08>;
						bias-disable;
						bias-pull-down;
						output-low;
					};
				};

				idt_enable_suspend: idt_enable_suspend {
					phandle = <0xa9>;

					mux {
						pins = "gpio155";
						function = "gpio";
					};

					config {
						pins = "gpio155";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};
			};

			sbu_uart_en_ctrl {

				sbu_uart_en_idle: uart_audio_en_idle {
					phandle = <0x9f>;

					mux {
						pins = "gpio159";
						function = "gpio";
					};

					config {
						pins = "gpio159";
						drive-strength = <0x02>;
						bias-pull-down;
						output-low;
					};
				};

				sbu_uart_en_active: uart_audio_en_active {
					phandle = <0x9e>;

					mux {
						pins = "gpio159";
						function = "gpio";
					};

					config {
						pins = "gpio159";
						drive-strength = <0x02>;
						bias-disable;
						output-high;
					};
				};
			};

			vbus_disable {

				vbus_disable_active: usb_vbus_active {
					phandle = <0xd2>;

					mux {
						pins = "gpio8";
						function = "gpio";
					};

					config {
						pins = "gpio8";
						drive-strength = <0x02>;
						bias-pull-up;
						output-high;
					};
				};

				vbus_disable_suspend: usb_vbus_suspend {
					phandle = <0x0a>;

					mux {
						pins = "gpio8";
						function = "gpio";
					};

					config {
						pins = "gpio8";
						drive-strength = <0x02>;
						bias-pull-down;
						output-low;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					interrupts = <0x00 0x08 0x00 0x03 0x00 0x08 0x01 0x03 0x00 0x08 0x03 0x03 0x00 0x08 0x04 0x03 0x00 0x08 0x05 0x03>;
					interrupt-names = "kpdpwr", "resin", "kpdpwr-bark", "resin-bark", "kpdpwr-resin-bark";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						qcom,pull-up;
						qcom,use-bark = <0x01>;
						qcom,support-reset = <0x01>;
						linux,code = <0x74>;
						qcom,s1-timer = <0x1180>;
						qcom,s2-timer = <0x7d0>;
						qcom,s2-type = <0x07>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						linux,code = <0x72>;
						qcom,pull-up;
					};

					qcom,pon_3 {
						qcom,pon-type = <0x03>;
						qcom,support-reset = <0x01>;
						qcom,pull-up;
						qcom,s1-timer = <0x548>;
						qcom,s2-timer = <0x7d0>;
						qcom,s2-type = <0x01>;
						qcom,use-bark;
					};
				};

				pm8150_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x00 0x24 0x00 0x03>;
					io-channels = <&pm8150_vadc>, <0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x02>;
				};

				pm8150_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x200>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x02>;
					clock-output-names = "pm8150_div_clk1", "pm8150_div_clk2";
					clocks = <&clock_rpmh>, <0x00>;
					clock-names = "xo";
					phandle = <0xd3>;
				};

				pm8150_sdam_2: sdam@b100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb100 0x100>;
					phandle = <0x18>;
				};

				pm8150_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xa00>;
					interrupts = <0x00 0xc0 0x00 0x00 0x00 0xc2 0x00 0x00 0x00 0xc5 0x00 0x00 0x00 0xc6 0x00 0x00 0x00 0xc8 0x00 0x00 0x00 0xc9 0x00 0x00>;
					interrupt-names = "pm8150_gpio1", "pm8150_gpio3", "pm8150_gpio6", "pm8150_gpio7", "pm8150_gpio9", "pm8150_gpio10";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x02 0x04 0x05 0x08>;
					phandle = <0x5f>;

					key_home {

						key_home_default: key_home_default {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0x60>;
						};
					};

					gps_clk {

						gps_clk_default: gps_clk_default {
							pins = "gpio3";
							function = "func1";
							output-low;
							bias-disable;
							intput-disable;
							power-source = <0x00>;
							phandle = <0xd4>;
						};
					};

					imu_clkin {

						imu_clkin_default: imu_clkin_default {
							pins = "gpio3";
							function = "func1";
							output-low;
							power-source = <0x00>;
							bias-disable;
							qcom,dtest-buffer = <0x01>;
							qcom,drive-strength = <0x01>;
							phandle = <0xd5>;
						};

						imu_clkin_sleep: imu_clkin_sleep {
							pins = "gpio3";
							function = "func1";
							input-enable;
							bias-pull-down;
							power-source = <0x00>;
							qcom,dtest-buffer = <0x01>;
							qcom,drive-strength = <0x01>;
							phandle = <0xd6>;
						};
					};

					key_vol_up {

						key_vol_up_default: key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x5e>;
						};
					};

					key_confirm {

						key_confirm_default: key_confirm_default {
							pins = "gpio7";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0xd7>;
						};
					};

					usb2_vbus_boost {

						usb2_vbus_boost_default: usb2_vbus_boost_default {
							pins = "gpio9";
							function = "normal";
							output-low;
							power-source = <0x01>;
							phandle = <0x63>;
						};
					};

					usb2_vbus_det {

						usb2_vbus_det_default: usb2_vbus_det_default {
							pins = "gpio10";
							function = "normal";
							input-enable;
							bias-pull-down;
							power-source = <0x01>;
							phandle = <0x62>;
						};
					};
				};

				pm8150_rtc: qcom,pm8150_rtc {
					compatible = "qcom,pm8941-rtc";
					interrupts = <0x00 0x61 0x01 0x00>;
					phandle = <0xd8>;
				};

				pm8150_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x01>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vcoin@85 {
						reg = <0x85>;
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
					};

					xo_therm@4c {
						reg = <0x4c>;
						label = "xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					skin_therm@4d {
						reg = <0x4d>;
						label = "skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1@4e {
						reg = <0x4e>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pm8150_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x00 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pm8150_vadc>, <0x4c>, <&pm8150_vadc>, <0x4d>, <&pm8150_vadc>, <0x4e>;
					phandle = <0xb3>;

					xo_therm@4c {
						reg = <0x4c>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					skin_therm@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm1@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@6 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8150_temp_alarm: pm8150_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150_tz>;
				wake-capable-sensor;
				phandle = <0xd9>;

				trips {

					pm8150_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xda>;
					};

					pm8150_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xdb>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@7 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm8150b_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x06>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				pm8150b_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x02 0x24 0x00 0x03>;
					io-channels = <&pm8150b_vadc>, <0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x1b>;
				};

				pm8150b_clkdiv: clock-controller@6000 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x6000 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm8150b_div_clk1";
					clocks = <&clock_rpmh>, <0x00>;
					clock-names = "xo";
					phandle = <0xdc>;
				};

				pm8150b_pbs1: qcom,pbs@7200 {
					compatible = "qcom,qpnp-pbs";
					reg = <0x7200 0x100>;
					phandle = <0x17>;
				};

				pm8150b_qnovo: qcom,sdam-qnovo@b000 {
					compatible = "qcom,qpnp-qnovo5";
					reg = <0xb000 0x100>;
					interrupts = <0x02 0xb0 0x01 0x01>;
					interrupt-names = "ptrain-done";
					pinctrl-names = "q_state1", "q_state2";
					pinctrl-0 = <&qnovo_fet_ctrl_state1>;
					pinctrl-1 = <&qnovo_fet_ctrl_state2>;
					phandle = <0xdd>;
				};

				pm8150b_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x02 0xc0 0x00 0x00 0x02 0xc1 0x00 0x00 0x02 0xc4 0x00 0x00 0x02 0xc5 0x00 0x00 0x02 0xc6 0x00 0x00 0x02 0xc7 0x00 0x00 0x02 0xc8 0x00 0x00 0x02 0xc9 0x00 0x00 0x02 0xcb 0x00 0x00>;
					interrupt-names = "pm8150b_gpio1", "pm8150b_gpio2", "pm8150b_gpio5", "pm8150b_gpio6", "pm8150b_gpio7", "pm8150b_gpio8", "pm8150b_gpio9", "pm8150b_gpio10", "pm8150b_gpio12";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x03 0x04 0x0b>;
					phandle = <0x08>;

					qnovo_fet_ctrl {

						qnovo_fet_ctrl_state1: qnovo_fet_ctrl_state1 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x04>;
						};

						qnovo_fet_ctrl_state2: qnovo_fet_ctrl_state2 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-down;
							power-source = <0x00>;
							phandle = <0x05>;
						};
					};

					smb_stat {

						smb_stat_default: smb_stat_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							qcom,pull-up-strength = <0x00>;
							power-source = <0x01>;
							phandle = <0x64>;
						};
					};

					haptics_boost {

						haptics_boost_default: haptics_boost_default {
							pins = "gpio5";
							function = "normal";
							output-enable;
							input-disable;
							bias-disable;
							qcom,drive-strength = <0x03>;
							power-source = <0x01>;
							phandle = <0x24>;
						};
					};

					otg_vbus_boost {

						otg_vbus_boost_default: otg_vbus_boost_default {
							pins = "gpio12";
							function = "normal";
							output-low;
							power-source = <0x00>;
							phandle = <0x61>;
						};
					};

					power_good {

						power_good_default: power_good_default {
							pins = "gpio7";
							function = "normal";
							qcom,drive-strength = <0x02>;
							power-source = <0x01>;
							bias-pull-down;
							input-enable;
							phandle = <0xa4>;
						};
					};

					wireless_ovp_en {

						wireless_ovp_en_default: wireless_ovp_en_default {
							pins = "gpio1";
							function = "normal";
							qcom,drive-strength = <0x02>;
							power-source = <0x01>;
							bias-pull-down;
							output-high;
							phandle = <0xde>;
						};
					};

					rx_sleep {

						rx_sleep_active: rx_sleep_active {
							pins = "gpio8";
							function = "normal";
							qcom,drive-strength = <0x02>;
							power-source = <0x01>;
							bias-pull-down;
							output-low;
							phandle = <0xdf>;
						};
					};

					wl_bq_en {

						wl_bq_en_default: wl_bq_en_default {
							pins = "gpio1";
							function = "normal";
							output-low;
							power-source = <0x00>;
							phandle = <0x09>;
						};
					};
				};

				pm8150b_charger: qcom,qpnp-smb5 {
					compatible = "qcom,qpnp-smb5";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					#cooling-cells = <0x02>;
					qcom,pmic-revid = <&pm8150b_revid>;
