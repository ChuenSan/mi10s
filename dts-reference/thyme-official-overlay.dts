					qcom,fcc-max-ua = <0x5b8d80>;
					qcom,fv-max-uv = <0x43e6d0>;
					qcom,non-fcc-fv-max-uv = <0x432380>;
					qcom,dc-icl-ua = <0xf4240>;
					qcom,auto-recharge-soc = <0x63>;
