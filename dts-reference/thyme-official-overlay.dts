				fts,touch-up-threshold-max = <0x78>;
				fts,touch-up-threshold-def = <0x50>;
				fts,touch-tolerance-min = <0x05>;
				fts,touch-tolerance-max = <0x23>;
				fts,touch-tolerance-def = <0x19>;
				fts,touch-idletime-min = <0x00>;
				fts,touch-idletime-max = <0x31ce>;
				fts,touch-idletime-def = <0x30a2>;
				fts,cornerfilter-area-step1 = <0x64>;
				fts,cornerfilter-area-step2 = <0xaa>;
				fts,cornerfilter-area-step3 = <0xfa>;
				fts,touch-deadzone-filter-ver = <0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x02 0x00 0x00 0x05 0x923 0x00 0x00 0x02 0x03 0x432 0x00 0x437 0x923 0x00 0x00>;
				fts,touch-deadzone-filter-hor = <0x02 0x00 0x00 0x00 0x437 0x05 0x00 0x00 0x02 0x01 0x00 0x91e 0x437 0x923 0x00 0x00 0x02 0x02 0x00 0x00 0x05 0x923 0x00 0x00 0x02 0x03 0x432 0x00 0x437 0x923 0x00 0x00>;
				fts,touch-edgezone-filter-ver = <0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x02 0x00 0x00 0x28 0x923 0x00 0x00 0x01 0x03 0x40f 0x00 0x437 0x923 0x00 0x00>;
				fts,touch-edgezone-filter-hor = <0x01 0x00 0x00 0x00 0x437 0x28 0x00 0x00 0x01 0x01 0x00 0x8fb 0x437 0x923 0x00 0x00 0x01 0x02 0x00 0x00 0x28 0x923 0x00 0x00 0x01 0x03 0x40f 0x00 0x437 0x923 0x00 0x00>;
				fts,touch-cornerzone-filter-ver = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x00 0x7f7 0x96 0x923 0x00 0x00 0x00 0x03 0x3a1 0x7f7 0x437 0x923 0x00 0x00>;
				fts,touch-cornerzone-filter-hor1 = <0x00 0x00 0x00 0x00 0xaa 0xaa 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x00 0x879 0xaa 0x923 0x00 0x00 0x00 0x03 0x00 0x00 0x00 0x00 0x00 0x00>;
				fts,touch-cornerzone-filter-hor2 = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x38d 0x00 0x437 0xaa 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x38d 0x879 0x437 0x923 0x00 0x00>;

