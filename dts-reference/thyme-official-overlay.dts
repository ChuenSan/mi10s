	};

	fragment@116 {
		target = <&qupv3_se13_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			qcom,i2c-touch-active = "st,fts";
			status = "ok";

			fts@49 {
				status = "ok";
				compatible = "st,fts";
				reg = <0x49>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x27 0x2008>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				avdd-supply = <&touch_vddio_vreg>;
				vdd-supply = <&pm8150a_l1>;
				fts,pwr-reg-name = "avdd";
				fts,bus-reg-name = "vdd";
				fts,irq-gpio = <&tlmm>, <0x27 0x2008>;
				fts,irq-gpio-name = "fts_irq";
				fts,reset-gpio-enable;
				fts,reset-gpio = <&tlmm>, <0x26 0x00>;
				fts,reset-gpio-name = "fts_rst";
				fts,irq-flags = <0x2008>;
				fts,x-max = <0x438>;
				fts,y-max = <0x924>;
				fts,fod-lx = <0x1a5>;
				fts,fod-ly = <0x6fc>;
				fts,fod-x-size = <0xee>;
