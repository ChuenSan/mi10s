	fragment@101 {
		target = <&q6core>;

		__overlay__ {

			cdc_dmic01_gpios: cdc_dmic01_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <&cdc_dmic01_clk_active>, <&cdc_dmic01_data_active>;
				pinctrl-1 = <&cdc_dmic01_clk_sleep>, <&cdc_dmic01_data_sleep>;
				qcom,lpi-gpios;
				phandle = <0x77>;
			};

			cdc_dmic23_gpios: cdc_dmic23_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <&cdc_dmic23_clk_active>, <&cdc_dmic23_data_active>;
				pinctrl-1 = <&cdc_dmic23_clk_sleep>, <&cdc_dmic23_data_sleep>;
				qcom,lpi-gpios;
				phandle = <0x78>;
			};

			cdc_dmic45_gpios: cdc_dmic45_pinctrl {
				status = "disabled";
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <&cdc_dmic45_clk_active>, <&cdc_dmic45_data_active>;
				pinctrl-1 = <&cdc_dmic45_clk_sleep>, <&cdc_dmic45_data_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-gpio = <0x9e>;
				phandle = <0x79>;
			};

			wsa_swr_gpios: wsa_swr_clk_data_pinctrl {
				status = "disabled";
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <&wsa_swr_clk_active>, <&wsa_swr_data_active>;
				pinctrl-1 = <&wsa_swr_clk_sleep>, <&wsa_swr_data_sleep>;
				qcom,lpi-gpios;
				phandle = <0x71>;
			};

			rx_swr_gpios: rx_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <&rx_swr_clk_active>, <&rx_swr_data_active>, <&rx_swr_data1_active>;
				pinctrl-1 = <&rx_swr_clk_sleep>, <&rx_swr_data_sleep>, <&rx_swr_data1_sleep>;
				qcom,lpi-gpios;
				phandle = <0x70>;
			};

			tx_swr_gpios: tx_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <&tx_swr_clk_active>, <&tx_swr_data1_active>, <&tx_swr_data2_active>;
				pinctrl-1 = <&tx_swr_clk_sleep>, <&tx_swr_data1_sleep>, <&tx_swr_data2_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-gpio = <0x93>;
				phandle = <0x6f>;
			};
		};
	};

	fragment@102 {
		target = <&soc>;

		__overlay__ {

			wsa_spkr_en1: wsa_spkr_en1_pinctrl {
