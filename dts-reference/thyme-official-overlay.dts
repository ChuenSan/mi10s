					qcom,fg-batt-soc@4000 {
						status = "okay";
						reg = <0x4000 0x100>;
						interrupts = <0x02 0x40 0x00 0x03 0x02 0x40 0x01 0x03 0x02 0x40 0x02 0x01 0x02 0x40 0x03 0x01 0x02 0x40 0x04 0x03 0x02 0x40 0x05 0x01 0x02 0x40 0x06 0x03 0x02 0x40 0x07 0x03>;
						interrupt-names = "soc-update", "soc-ready", "bsoc-delta", "msoc-delta", "msoc-low", "msoc-empty", "msoc-high", "msoc-full";
					};

					qcom,fg-batt-info@4100 {
						status = "okay";
						reg = <0x4100 0x100>;
						interrupts = <0x02 0x41 0x00 0x03 0x02 0x41 0x01 0x03 0x02 0x41 0x03 0x01>;
						interrupt-names = "vbatt-low", "vbatt-pred-delta", "esr-delta";
					};

					qcom,fg-rradc@4200 {
						status = "okay";
						reg = <0x4200 0x100>;
						interrupts = <0x02 0x42 0x00 0x03 0x02 0x42 0x01 0x03 0x02 0x42 0x02 0x03 0x02 0x42 0x03 0x03 0x02 0x42 0x04 0x03>;
						interrupt-names = "batt-missing", "batt-id", "batt-temp-delta", "batt-temp-hot", "batt-temp-cold";
					};

					qcom,fg-memif@4300 {
						status = "okay";
						reg = <0x4300 0x100>;
						interrupts = <0x02 0x43 0x00 0x03 0x02 0x43 0x01 0x03 0x02 0x43 0x02 0x03 0x02 0x43 0x03 0x01 0x02 0x43 0x04 0x02>;
						interrupt-names = "ima-rdy", "ima-xcp", "dma-xcp", "dma-grant", "mem-attn";
					};
				};

				pm8150b_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100 0x3700 0x100>;
					reg-names = "adc5-usr-base", "adc5-cal-base";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x02 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x03>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_temp@9 {
						reg = <0x09>;
						label = "chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_id@4b {
						reg = <0x4b>;
						label = "bat_id";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1390_therm@e {
						reg = <0x0e>;
						label = "smb1390_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1355_therm@4e {
						reg = <0x4e>;
						label = "smb1355_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					wireless_therm {
						reg = <0x4d>;
						label = "wireless_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					conn_therm@4f {
						reg = <0x4f>;
						label = "conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_sbux@99 {
						reg = <0x99>;
						label = "chg_sbux";
						qcom,pre-scaling = <0x01 0x03>;
					};

					mid_chg_div6@1e {
						reg = <0x1e>;
						label = "chg_mid";
						qcom,pre-scaling = <0x01 0x06>;
					};

					usb_in_i_uv@7 {
						reg = <0x07>;
						label = "usb_in_i_uv";
						qcom,pre-scaling = <0x01 0x01>;
					};

					usb_in_v_div_16@8 {
						reg = <0x08>;
						label = "usb_in_v_div_16";
						qcom,pre-scaling = <0x01 0x10>;
					};
				};

				pm8150b_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x02 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					qcom,pmic-revid = <&pm8150b_revid>;
					io-channels = <&pm8150b_vadc>, <0x4d>, <&pm8150b_vadc>, <0x4f>;
					phandle = <0xb2>;

					wireless_therm@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					conn_therm@4f {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150b@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm8150b_pwm: qcom,pwms@b100 {
					compatible = "qcom,pwm-lpg";
					reg = <0xb100 0x200>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x02>;
					phandle = <0x19>;
				};

				pm8150b_hr_led: qcom,leds@d000 {
					compatible = "qcom,tri-led";
					reg = <0xd000 0x100>;
					nvmem-names = "pbs_sdam";
					nvmem = <&pm8150_sdam_2>;
					phandle = <0xe3>;

					hr_led1 {
						label = "hr_led1";
						pwms = <&pm8150b_pwm>, <0x00 0xf4240>;
						led-sources = <0x00>;
					};

					hr_led2 {
						label = "hr_led2";
						pwms = <&pm8150b_pwm>, <0x01 0xf4240>;
						led-sources = <0x01>;
					};
				};

				pm8150b_haptics: qcom,haptics@c000 {
					compatible = "qcom,haptics";
					reg = <0xc000 0x100>;
					interrupts = <0x03 0xc0 0x00 0x03 0x03 0xc0 0x01 0x03>;
					interrupt-names = "hap-sc-irq", "hap-play-irq";
					qcom,actuator-type = "lra";
					qcom,vmax-mv = <0xe10>;
					qcom,play-rate-us = <0x1a0b>;
					qcom,lra-resonance-sig-shape = "sine";
					qcom,lra-auto-resonance-mode = "qwd";
					qcom,lra-allow-variable-play-rate;
					vdd-supply = <&vreg_hap_boost>;
					phandle = <0xe4>;

					wf_0 {
						qcom,effect-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_1 {
						qcom,effect-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_2 {
						qcom,effect-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_3 {
						qcom,effect-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_4 {
						qcom,effect-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_5 {
						qcom,effect-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};
				};
			};
		};
	};

	fragment@8 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8150b_temp_alarm: pm8150b_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150b_tz>;
				wake-capable-sensor;
				phandle = <0xe5>;

				trips {

					pm8150b_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xe6>;
					};

					pm8150b_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xe7>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};

			pm8150b-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150b_bcl>, <0x00>;
				wake-capable-sensor;

				trips {

					ibat_lvl0: ibat-lvl0 {
						temperature = <0x157c>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xe8>;
					};
				};
			};

			pm8150b-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150b_bcl>, <0x01>;
				wake-capable-sensor;

				trips {

					ibat_lvl1: ibat-lvl1 {
						temperature = <0x251c>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xe9>;
					};
				};
			};

			pm8150b-vbat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150b_bcl>, <0x02>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vbat_lvl0: vbat-lvl0 {
						temperature = <0xbb8>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xea>;
					};
				};
			};

			pm8150b-vbat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150b_bcl>, <0x03>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vbat_lvl1: vbat-lvl1 {
						temperature = <0xaf0>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xeb>;
					};
				};
			};

			pm8150b-vbat-lvl2 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150b_bcl>, <0x04>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vbat_lvl2: vbat-lvl2 {
						temperature = <0xa28>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xec>;
					};
				};
			};

			pm8150b-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150b_bcl>, <0x05>;
				wake-capable-sensor;

				trips {

					b_bcl_lvl0: b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x58>;
					};
				};
			};

			pm8150b-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150b_bcl>, <0x06>;
				wake-capable-sensor;

				trips {

					b_bcl_lvl1: b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x59>;
					};
				};
			};

			pm8150b-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150b_bcl>, <0x07>;
				wake-capable-sensor;

				trips {

					b_bcl_lvl2: b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x5a>;
					};
				};
			};

			soc {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&bcl_soc>;
				tracks-low;
				wake-capable-sensor;

				trips {

					soc_trip: soc-trip {
						temperature = <0x0a>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x57>;
					};
				};
			};
		};
	};

	fragment@9 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150l@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm8150l_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x1f>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				pm8150l_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x04 0x24 0x00 0x03>;
					io-channels = <&pm8150l_vadc>, <0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x21>;
				};

				pm8150l_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm8150l_div_clk1";
					clocks = <&clock_rpmh>, <0x00>;
					clock-names = "xo";
					phandle = <0xed>;
				};

				pm8150l_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x04 0xc0 0x00 0x00 0x04 0xc2 0x00 0x00 0x04 0xc3 0x00 0x00 0x04 0xc4 0x00 0x00 0x04 0xc5 0x00 0x00 0x04 0xc6 0x00 0x00 0x04 0xc7 0x00 0x00 0x04 0xc9 0x00 0x00 0x04 0xca 0x00 0x00>;
					interrupt-names = "pm8150l_gpio1", "pm8150l_gpio3", "pm8150l_gpio4", "pm8150l_gpio5", "pm8150l_gpio6", "pm8150l_gpio7", "pm8150l_gpio8", "pm8150l_gpio10", "pm8150l_gpio11";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x02 0x09 0x0c>;
					phandle = <0xba>;
				};

				pm8150l_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x04 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x1e>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					camera_flash_therm@4d {
						reg = <0x4d>;
						label = "camera_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					skin_msm_therm@4e {
						reg = <0x4e>;
						label = "skin_msm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm2@4f {
						reg = <0x4f>;
						label = "pa_therm2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pm8150l_bcl: bcl@3d00 {
					compatible = "qcom,bcl-v5";
					reg = <0x3d00 0x100>;
					interrupts = <0x04 0x3d 0x00 0x00 0x04 0x3d 0x01 0x00 0x04 0x3d 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					#thermal-sensor-cells = <0x01>;
					phandle = <0x22>;
				};

				pm8150l_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x04 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pm8150l_vadc>, <0x4d>, <&pm8150l_vadc>, <0x4e>, <&pm8150l_vadc>, <0x4f>;
					phandle = <0xb4>;

					camera_flash_therm@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					skin_msm_therm@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm2@4f {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150l@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm8150l_lcdb: qcom,lcdb@ec00 {
					compatible = "qcom,qpnp-lcdb-regulator";
					reg = <0xec00 0x100>;
					interrupts = <0x05 0xec 0x01 0x01>;
					interrupt-names = "sc-irq";
					qcom,pmic-revid = <&pm8150l_revid>;
					status = "disabled";
					phandle = <0xee>;

					lcdb_ldo_vreg: ldo {
						label = "ldo";
						regulator-name = "lcdb_ldo";
						regulator-min-microvolt = "", "=\t";
						regulator-max-microvolt = <0x5b8d80>;
						phandle = <0xef>;
					};

					lcdb_ncp_vreg: ncp {
						label = "ncp";
						regulator-name = "lcdb_ncp";
						regulator-min-microvolt = "", "=\t";
						regulator-max-microvolt = <0x5b8d80>;
						phandle = <0xf0>;
					};

					lcdb_bst_vreg: bst {
						label = "bst";
						regulator-name = "lcdb_bst";
						regulator-min-microvolt = <0x47b760>;
						regulator-max-microvolt = <0x5fbfb8>;
						phandle = <0xf1>;
					};
				};

				flash_led: qcom,leds@d300 {
					compatible = "qcom,qpnp-flash-led-v2";
					status = "okay";
					reg = <0xd300 0x100>;
					label = "flash";
					interrupts = <0x05 0xd3 0x00 0x01 0x05 0xd3 0x03 0x01 0x05 0xd3 0x04 0x01>;
					interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
					qcom,hdrm-auto-mode;
					qcom,short-circuit-det;
					qcom,open-circuit-det;
					qcom,vph-droop-det;
					qcom,thermal-derate-en;
					qcom,thermal-derate-current = <0xc8 0x1f4 0x3e8>;
					qcom,isc-delay = <0xc0>;
					qcom,pmic-revid = <&pm8150l_revid>;
					phandle = <0xf2>;

					pm8150l_flash0: qcom,flash_0 {
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,current-ma = <0x3e8>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						phandle = <0xb5>;
					};

					pm8150l_flash1: qcom,flash_1 {
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,current-ma = <0x3e8>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						phandle = <0xb6>;
					};

					pm8150l_flash2: qcom,flash_2 {
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current = <0x2ee>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,current-ma = <0x1f4>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						status = "disabled";
						phandle = <0xf3>;
					};

					pm8150l_torch0: qcom,torch_0 {
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,current-ma = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						phandle = <0xb7>;
					};

					pm8150l_torch1: qcom,torch_1 {
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x01>;
						qcom,current-ma = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						phandle = <0xb8>;
					};

					pm8150l_torch2: qcom,torch_2 {
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x02>;
						qcom,current-ma = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						status = "disabled";
						phandle = <0xf4>;
					};

					pm8150l_switch0: qcom,led_switch_0 {
						label = "switch";
						qcom,led-name = "led:switch_0";
						qcom,led-mask = <0x01>;
						qcom,default-led-trigger = "switch0_trigger";
						phandle = <0xf5>;
					};

					pm8150l_switch1: qcom,led_switch_1 {
						label = "switch";
						qcom,led-name = "led:switch_1";
						qcom,led-mask = <0x02>;
						qcom,default-led-trigger = "switch1_trigger";
						phandle = <0xf6>;
					};

					pm8150l_switch2: qcom,led_switch_2 {
						label = "switch";
						qcom,led-name = "led:switch_2";
						qcom,led-mask = <0x03>;
						qcom,default-led-trigger = "switch2_trigger";
						phandle = <0xb9>;
					};

					pm8150l_switch3: qcom,led_switch_3 {
						label = "switch";
						qcom,led-name = "led:switch_3";
						qcom,led-mask = <0x04>;
						qcom,default-led-trigger = "switch3_trigger";
						phandle = <0xf7>;
					};

					pm8150l_flashlight: qcom,flashlight {
						label = "flash";
						qcom,led-name = "flashlight";
						qcom,max-current = <0x2ee>;
						qcom,default-led-trigger = "flashlight_trigger";
						qcom,id = <0x03>;
						qcom,current-ma = <0x1f4>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						phandle = <0xf8>;
					};
				};

				pm8150l_wled: qcom,wled@d800 {
					compatible = "qcom,pm8150l-spmi-wled";
					reg = <0xd800 0x100 0xd900 0x100>;
					reg-names = "wled-ctrl-base", "wled-sink-base";
					label = "backlight";
					interrupts = <0x05 0xd8 0x01 0x01 0x05 0xd8 0x04 0x03 0x05 0xd8 0x05 0x03>;
					interrupt-names = "ovp-irq", "pre-flash-irq", "flash-irq";
					qcom,pmic-revid = <&pm8150l_revid>;
					qcom,auto-calibration;
					status = "disabled";
					phandle = <0xf9>;

					wled_flash: qcom,wled-flash {
						label = "flash";
						qcom,default-led-trigger = "wled_flash";
						phandle = <0xfa>;
					};

					wled_torch: qcom,wled-torch {
						label = "torch";
						qcom,default-led-trigger = "wled_torch";
						qcom,wled-torch-timer = <0x4b0>;
						phandle = <0xfb>;
					};

					wled_switch: qcom,wled-switch {
						label = "switch";
						qcom,default-led-trigger = "wled_switch";
						phandle = <0xfc>;
					};
				};

				pm8150l_lpg: qcom,pwms@b100 {
					compatible = "qcom,pwm-lpg";
					reg = <0xb100 0x300 0xb000 0x100>;
					reg-names = "lpg-base", "lut-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x03>;
					qcom,lut-patterns = <0x00 0x0a 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0x0a 0x00>;
					phandle = <0x20>;

					lpg1 {
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-pause-hi-count = <0x02>;
						qcom,ramp-pause-lo-count = <0x02>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-pattern-repeat;
					};

					lpg2 {
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-pause-hi-count = <0x02>;
						qcom,ramp-pause-lo-count = <0x02>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-pattern-repeat;
					};

					lpg3 {
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-pause-hi-count = <0x02>;
						qcom,ramp-pause-lo-count = <0x02>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-pattern-repeat;
					};
				};

				pm8150l_pwm: qcom,pwms@bc00 {
					compatible = "qcom,pwm-lpg";
					reg = <0xbc00 0x200>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x02>;
					phandle = <0xfd>;
				};

				pm8150l_rgb_led: qcom,leds@d000 {
					compatible = "qcom,tri-led";
					reg = <0xd000 0x100>;
					phandle = <0xfe>;

					red {
						label = "red";
						pwms = <&pm8150l_lpg>, <0x00 0xf4240>;
						led-sources = <0x00>;
						linux,default-trigger = "timer";
					};

					green {
						label = "green";
						pwms = <&pm8150l_lpg>, <0x01 0xf4240>;
						led-sources = <0x01>;
						linux,default-trigger = "timer";
					};

					blue {
						label = "blue";
						pwms = <&pm8150l_lpg>, <0x02 0xf4240>;
						led-sources = <0x02>;
						linux,default-trigger = "timer";
					};
				};

				pm8150a_amoled: qcom,amoled {
					compatible = "qcom,qpnp-amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					status = "ok";
					phandle = <0xff>;

					oledb_vreg: oledb@e000 {
						reg = <0xe000 0x100>;
						reg-names = "oledb_base";
						regulator-name = "oledb";
						regulator-min-microvolt = <0x4b2648>;
						regulator-max-microvolt = <0x7b98a0>;
						qcom,swire-control;
						phandle = <0x100>;
					};

					ab_vreg: ab@de00 {
						reg = <0xde00 0x100>;
						reg-names = "ab_base";
						regulator-name = "ab";
						regulator-min-microvolt = <0x4630c0>;
						regulator-max-microvolt = <0x5d1420>;
						qcom,swire-control;
						phandle = <0x35>;
					};

					ibb_vreg: ibb@dc00 {
						reg = <0xdc00 0x100>;
						reg-names = "ibb_base";
						regulator-name = "ibb";
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0x5265c0>;
						qcom,swire-control;
						phandle = <0x36>;
					};
				};
			};
		};
	};

	fragment@10 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8150l_temp_alarm: pm8150l_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_tz>;
				wake-capable-sensor;
				phandle = <0x101>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150l_bcl>, <0x02>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph_lvl0: vph-lvl0 {
						temperature = <0xbb8>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x102>;
					};
				};
			};

			pm8150l-vph-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150l_bcl>, <0x03>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph_lvl1: vph-lvl1 {
						temperature = <0xabe>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x103>;
					};
				};
			};

			pm8150l-vph-lvl2 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150l_bcl>, <0x04>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph_lvl2: vph-lvl2 {
						temperature = <0x9c4>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x104>;
					};
				};
			};

			pm8150l-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_bcl>, <0x05>;
				wake-capable-sensor;

				trips {

					l_bcl_lvl0: l-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x5b>;
					};
				};
			};

			pm8150l-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_bcl>, <0x06>;
				wake-capable-sensor;

				trips {

					l_bcl_lvl1: l-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x5c>;
					};
				};
			};

			pm8150l-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_bcl>, <0x07>;
				wake-capable-sensor;

				trips {

					l_bcl_lvl2: l-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x5d>;
					};
				};
			};
		};
	};

	fragment@11 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8009@a {
				compatible = "qcom,spmi-pmic";
				reg = <0x0a 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				pm8009_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0x400>;
					interrupts = <0x0a 0xc0 0x00 0x00 0x0a 0xc1 0x00 0x00 0x0a 0xc2 0x00 0x00 0x0a 0xc3 0x00 0x00>;
					interrupt-names = "pm8009_gpio1", "pm8009_gpio2", "pm8009_gpio3", "pm8009_gpio4";
					gpio-controller;
					#gpio-cells = <0x02>;
					phandle = <0x23>;

					cam0_reset {

						cam0_reset_default: cam0_reset_default {
							pins = "gpio4";
							function = "normal";
							power-source = <0x01>;
							output-low;
							phandle = <0xc1>;
						};
					};

					cam3_reset {

						cam3_reset_default: cam3_reset_default {
							pins = "gpio3";
							function = "normal";
							power-source = <0x01>;
							output-low;
							phandle = <0xcc>;
						};
					};

					cam4_reset {

						cam4_reset_default: cam4_reset_default {
							pins = "gpio2";
							function = "normal";
							power-source = <0x01>;
							output-low;
							phandle = <0xcf>;
						};
					};

					cam4_vdig {

						cam4_vdig_default: cam4_vdig_default {
							pins = "gpio1";
							function = "normal";
							power-source = <0x01>;
							output-low;
							phandle = <0xd0>;
						};
					};
				};
			};

			qcom,pm8009@b {
				compatible = "qcom,spmi-pmic";
				reg = <0x0b 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@12 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmxprairie@8 {
				compatible = "qcom,spmi-pmic";
				reg = <0x08 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					qcom,modem-reset;
				};
			};

			qcom,pmxprairie@9 {
				compatible = "qcom,spmi-pmic";
				reg = <0x09 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@13 {
		target = <&soc>;

		__overlay__ {

			vreg_tof: regulator-dbb1 {
				compatible = "regulator-fixed";
				regulator-name = "vdd_tof";
				regulator-min-microvolt = <0x36ee80>;
				regulator-max-microvolt = <0x36ee80>;
				gpio = <&pm8009_gpios>, <0x01 0x00>;
				startup-delay-us = <0x3e8>;
				enable-active-high;
				phandle = <0x105>;
			};

			vreg_hap_boost: regulator-haptics-boost {
				compatible = "regulator-fixed";
				regulator-name = "vdd_hap_boost";
				gpio = <&pm8150b_gpios>, <0x05 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&haptics_boost_default>;
				startup-delay-us = <0x3e8>;
				enable-active-high;
				status = "ok";
				phandle = <0x1a>;
			};
		};
	};

	fragment@14 {
		target = <&usb0>;

		__overlay__ {
			extcon = <&pm8150b_pdphy>, <&eud>;
		};
	};

	fragment@15 {
		target = <&usb_qmp_dp_phy>;

		__overlay__ {
			extcon = <&pm8150b_pdphy>;
		};
	};

	fragment@16 {
		target = <&sde_dp>;

		__overlay__ {
			extcon = <&pm8150b_pdphy>;
		};
	};

	fragment@17 {
		target = <&mdss_mdp>;

		__overlay__ {

			dsi_sw43404_amoled_cmd: qcom,mdss_dsi_sw43404_amoled_wqhd_cmd {
				qcom,mdss-dsi-panel-name = "sw43404 amoled cmd mode dsi boe panel with DSC";
				qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
				qcom,mdss-dsi-panel-physical-type = "oled";
				qcom,mdss-dsi-virtual-channel-id = <0x00>;
				qcom,mdss-dsi-stream = <0x00>;
				qcom,mdss-dsi-bpp = <0x18>;
				qcom,mdss-dsi-color-order = "rgb_swap_rgb";
				qcom,mdss-dsi-underflow-color = <0xff>;
				qcom,mdss-dsi-border-color = <0x00>;
				qcom,dsi-ctrl-num = <0x00>;
				qcom,dsi-phy-num = <0x00>;
				qcom,mdss-dsi-traffic-mode = "non_burst_sync_event";
				qcom,mdss-dsi-lane-map = "lane_map_0123";
				qcom,mdss-dsi-bllp-eof-power-mode;
