					mi,support-qc3p5-without-smb;
					qcom,sw-jeita-enable;
					qcom,chg-warm-th = <0x1c2>;
					qcom,chg-cool-th = <0x96>;
					mi,ncp-enable = <&tlmm>, <0x98 0x00>;
