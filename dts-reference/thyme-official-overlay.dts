				goodix,cfg-name = "goodix_gt9886_cfg_J2.bin";
				goodix,fw-name = "goodix_gt9886_fw_J2.bin";
				normal-cfg;

				sensor0 {
					goodix,fw-name = "goodix_gt9886_fw_J2.bin";
					goodix,x2x;
					goodix,y2y;
				};

				sensor1 {
					goodix,fw-name = "goodix_gt9886_fw_J2.bin";
				};
			};
		};
	};

