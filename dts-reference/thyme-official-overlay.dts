					qcom,thermal-mitigation-bpp-qc2 = <0xf4240 0xf4240 0xf4240 0xf4240 0xf4240 0xf4240 0xf4240 0xaae60 0xaae60 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120 0x61a80 0x493e0>;
					qcom,thermal-mitigation-bpp = <0xcf850 0xcf850 0xcf850 0xcf850 0xcf850 0xcf850 0xcf850 0xaae60 0xaae60 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120 0x61a80 0x493e0>;
