	fragment@96 {
		target = <&q6core>;

		__overlay__ {

			lpi_tlmm: lpi_pinctrl@33c0000 {
				compatible = "qcom,lpi-pinctrl";
				reg = <0x33c0000 0x00>;
				qcom,slew-reg = <0x355a000 0x00>;
				qcom,num-gpios = <0x0e>;
				gpio-controller;
				#gpio-cells = <0x02>;
				qcom,lpi-offset-tbl = <0x00 0x1000 0x2000 0x3000 0x4000 0x5000 0x6000 0x7000 0x8000 0x9000 0xa000 0xb000 0xc000 0xd000>;
				qcom,lpi-slew-offset-tbl = <0x00 0x02 0x04 0x08 0x0a 0x0c 0x00 0x00 0x00 0x00 0x10 0x12 0x00 0x00>;
				clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
				clocks = <&lpass_core_hw_vote>, <0x00>, <&lpass_audio_hw_vote>, <0x00>;
				phandle = <0x80>;

				quat_mi2s_sck {

					quat_mi2s_sck_sleep: quat_mi2s_sck_sleep {
						phandle = <0x126>;

						mux {
							pins = "gpio0";
							function = "func2";
						};

						config {
							pins = "gpio0";
							drive-strength = <0x02>;
							bias-pull-down;
							input-enable;
						};
					};

					quat_mi2s_sck_active: quat_mi2s_sck_active {
						phandle = <0x127>;

						mux {
							pins = "gpio0";
							function = "func2";
						};

						config {
							pins = "gpio0";
							drive-strength = <0x08>;
							bias-disable;
							output-high;
						};
					};
				};

				quat_mi2s_ws {

					quat_mi2s_ws_sleep: quat_mi2s_ws_sleep {
						phandle = <0x128>;

						mux {
							pins = "gpio1";
							function = "func2";
						};

						config {
							pins = "gpio1";
							drive-strength = <0x02>;
							bias-pull-down;
							input-enable;
						};
					};

					quat_mi2s_ws_active: quat_mi2s_ws_active {
						phandle = <0x129>;

						mux {
							pins = "gpio1";
							function = "func2";
						};

						config {
							pins = "gpio1";
							drive-strength = <0x08>;
							bias-disable;
							output-high;
						};
					};
				};

				quat_mi2s_sd0 {

					quat_mi2s_sd0_sleep: quat_mi2s_sd0_sleep {
						phandle = <0x12a>;

						mux {
							pins = "gpio2";
							function = "func2";
						};

						config {
							pins = "gpio2";
							drive-strength = <0x02>;
							bias-pull-down;
							input-enable;
						};
					};

					quat_mi2s_sd0_active: quat_mi2s_sd0_active {
						phandle = <0x12b>;

						mux {
							pins = "gpio2";
							function = "func2";
						};

						config {
							pins = "gpio2";
							drive-strength = <0x08>;
							bias-disable;
							output-high;
						};
					};
				};

				quat_mi2s_sd1 {

					quat_mi2s_sd1_sleep: quat_mi2s_sd1_sleep {
						phandle = <0x12c>;

