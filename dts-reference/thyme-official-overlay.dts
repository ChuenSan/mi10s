		target = <&mdss_mdp>;

		__overlay__ {
			connectors = <&sde_wb>, <&sde_dsi>, <&sde_dsi1>, <&sde_rscc>;
		};
	};

	fragment@111 {
		target = <&usb1>;

		__overlay__ {
			extcon = <&extcon_usb1>;
		};
	};

	fragment@112 {
		target = <&qupv3_se15_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";

			bq25970-standalone@66 {
				compatible = "ti,bq2597x-standalone";
				reg = <0x66>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x44 0x2002>;
				pinctrl-names = "default";
				pinctrl-0 = <&bq2597x_master_int_default>;
				ti,bq2597x,bat-ovp-alarm-disable;
				ti,bq2597x,bat-ocp-disable;
				ti,bq2597x,bat-ocp-alarm-disable;
				ti,bq2597x,bat-ucp-alarm-disable;
				ti,bq2597x,bat-ucp-disable;
				ti,bq2597x,bat-therm-disable;
				ti,bq2597x,bus-therm-disable;
				ti,bq2597x,die-therm-disable;
				ti,bq2597x,bat-ovp-threshold = <0x11c6>;
				ti,bq2597x,bat-ovp-alarm-threshold = <0x11ad>;
				ti,bq2597x,bus-ovp-threshold = <0x2ee0>;
				ti,bq2597x,bus-ovp-alarm-threshold = <0x2af8>;
				ti,bq2597x,bus-ocp-threshold = <0xea6>;
				ti,bq2597x,bus-ocp-alarm-threshold = <0xdac>;
				ti,bq2597x,bat-therm-threshold = <0x15>;
				ti,bq2597x,bus-therm-threshold = <0x15>;
				ti,bq2597x,die-therm-threshold = <0x91>;
				ti,bq2597x,ac-ovp-threshold = <0x0e>;
			};

			halo,hl6111r@25 {
				compatible = "halo,hl6111r";
				reg = <0x25>;
				status = "disabled";
			};
		};
	};

	fragment@113 {
		target = <&qupv3_se16_i2c>;

		__overlay__ {
			status = "ok";

			ln8282@55 {
				compatible = "lionsemi,ln8282";
				status = "ok";
				reg = <0x55>;
				ln,enable = <&tlmm>, <0x9c 0x00>;
				ln,irq = <&tlmm>, <0x9e 0x00>;
				pinctrl-names = "ln8282_active", "ln8282_suspend";
				pinctrl-0 = <&ln8282_enable_active>;
				pinctrl-1 = <&ln8282_enable_suspend>;
			};

			idtp9415: idtp9415@3b {
				compatible = "idt,p9415";
				status = "ok";
				reg = <0x3b>;
				idt,irq = <&tlmm>, <0x9d 0x00>;
				idt,enable = <&tlmm>, <0x9b 0x00>;
				idt,reverse-enable = <&tlmm>, <0x9a 0x00>;
				idt,wpc-det = <&pm8150b_gpios>, <0x07 0x00>;
				pinctrl-names = "default", "idt_active", "idt_suspend";
				pinctrl-0 = <&power_good_default>;
				pinctrl-1 = <&idt_int_active>, <&idt_enable_active>, <&txon_enable_active>;
				pinctrl-2 = <&idt_int_suspend>, <&idt_enable_suspend>, <&txon_enable_suspend>;
				mi,wireless-by-usbin;
				phandle = <0x181>;
			};

			rx1619@61 {
				compatible = "nuvolta,wl_charger_rx1619";
				reg = <0x61>;
				status = "ok";
				rx,irq_gpio = <&tlmm>, <0x9d 0x00>;
				rx,tx_on_gpio = <&tlmm>, <0x9a 0x00>;
				rx,power_good = <&pm8150b_gpios>, <0x07 0x00>;
				rx,enable = <&tlmm>, <0x9b 0x00>;
				pinctrl-names = "default", "nu_active", "nu_suspend";
				pinctrl-0 = <&power_good_default>;
				pinctrl-1 = <&nu_int_active>, <&txon_enable_active>, <&nu_sleep_active>;
				pinctrl-2 = <&nu_int_suspend>, <&txon_enable_suspend>, <&nu_sleep_suspend>;
				mi,wireless-by-usbin;
			};

			rx1619@67 {
				compatible = "nuvolta,wl_rx1619_trim";
				reg = <0x67>;
				status = "ok";
			};
		};
	};

	fragment@114 {
		target = <&qupv3_se3_i2c>;

		__overlay__ {
			status = "ok";

			cs35l41@40 {
				#sound-dai-cells = <0x01>;
				compatible = "cirrus,cs35l41";
				reset-gpios = <&tlmm>, <0x72 0x00>;
				reg = <0x40>;
				pinctrl-names = "cs35l41_irq_speaker";
				pinctrl-0 = <&cs35l41_int_speaker>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x71 0x08>;
				cirrus,temp-warn_threshold = <0x03>;
				cirrus,boost-peak-milliamp = <0xfa0>;
				cirrus,boost-ind-nanohenry = <0x3e8>;
				cirrus,boost-cap-microfarad = <0x0f>;
				cirrus,asp-sdout-hiz = <0x01>;
				cirrus,right-channel-amp;

				cirrus,gpio-config2 {
					cirrus,gpio-src-select = <0x04>;
					cirrus,gpio-output-enable;
				};
			};

			cs35l41@42 {
				#sound-dai-cells = <0x01>;
				compatible = "cirrus,cs35l41";
				reset-gpios = <&tlmm>, <0x72 0x00>;
				reg = <0x42>;
				pinctrl-names = "cs35l41_irq_speaker_rcv";
				pinctrl-0 = <&cs35l41_int_speaker_rcv>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x70 0x08>;
				cirrus,temp-warn_threshold = <0x03>;
				cirrus,boost-peak-milliamp = <0xfa0>;
				cirrus,boost-ind-nanohenry = <0x3e8>;
				cirrus,boost-cap-microfarad = <0x0f>;
				cirrus,asp-sdout-hiz = <0x01>;
				sound-name-prefix = "RCV";

				cirrus,gpio-config2 {
					cirrus,gpio-src-select = <0x04>;
					cirrus,gpio-output-enable;
				};
			};
		};
	};

	fragment@115 {
		target = <&qupv3_se11_i2c>;

		__overlay__ {
